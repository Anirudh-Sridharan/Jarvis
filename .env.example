# --- Local MLX sidecar (feature 1) ---
MLX_SIDECAR_URL=http://127.0.0.1:8088
MLX_SIDECAR_PORT=8088

# --- Fireworks AI (serverless, OpenAI-compatible) for the heavy consolidation lane ---
# FIREWORKS_API_KEY: from fireworks.ai/account/api-keys
FIREWORKS_API_KEY=
# FIREWORKS_ENDPOINT_URL=https://api.fireworks.ai/inference/v1

# --- Anthropic Claude (OpenAI-SDK-compatible endpoint) for agent + reasoning task classes ---
# ANTHROPIC_API_KEY: from console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_ENDPOINT_URL=https://api.anthropic.com/v1

# --- Core service ---
CORE_PORT=8080

# --- Firecrawl (agent web_extract page extraction) ---
# FIRECRAWL_API_KEY: from firecrawl.dev
FIRECRAWL_API_KEY=

# --- Browser Use Cloud (phase 13.3 eval only — not wired as an agent tool) ---
# BROWSER_USE_API_KEY: from cloud.browser-use.com
BROWSER_USE_API_KEY=

# --- Data dir (capture journal, dbs, checkpoints) ---
JARVIS_DATA_DIR=./data
