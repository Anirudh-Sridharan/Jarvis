# --- Local MLX sidecar (feature 1) ---
MLX_SIDECAR_URL=http://127.0.0.1:8088
MLX_SIDECAR_PORT=8088

# --- Hugging Face Inference Providers (serverless router) for heavy reasoning + nightly consolidation ---
# Serverless, pay-per-token, no endpoint to provision. OpenAI-compatible.
# HF_TOKEN: fine-grained token with "Make calls to Inference Providers" — hf.co/settings/tokens
HF_ENDPOINT_URL=https://router.huggingface.co/v1/chat/completions
HF_TOKEN=

# --- Core service ---
CORE_PORT=8080

# --- Data dir (capture journal, dbs, checkpoints) ---
JARVIS_DATA_DIR=./data
