{
  "name": "jarvis",
  "private": true,
  "version": "0.1.0",
  "description": "Jarvis — a local-first, persistent-memory personal AI assistant. See features.md and architecture/.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "bash scripts/start.sh",
    "core": "npm --workspace @jarvis/core run dev",
    "core:build": "npm --workspace @jarvis/core run build",
    "dashboard": "npm --workspace @jarvis/dashboard run dev",
    "chat": "npm --workspace @jarvis/core run chat",
    "connect": "npm --workspace @jarvis/core run connect --",
    "voice": "npm --workspace @jarvis/core run voice",
    "eval:browser-use": "npm --workspace @jarvis/core run eval:browser-use --",
    "eval:recall": "npm --workspace @jarvis/core run eval:recall --",
    "mac-doctor": "npm --workspace @jarvis/core run mac-doctor --",
    "sidecar": "bash sidecar/mlx/run.sh",
    "sidecar:voice": "bash sidecar/voice/run.sh"
  }
}
